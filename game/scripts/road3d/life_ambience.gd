class_name LifeAmbience
extends Node
## T-189 (vida): ambient sound by biome and time of day, as quiet loops under the engine:
##   mountain by day -> cicadas; coast -> sea waves; city (viaduct) -> city hum; night outside the city -> frogs and
##   crickets; by day, birds (mountain/coast). Inside a tunnel everything fades out.
## The files are generated by Marco (docs/AUDIO_ELEVENLABS.md, T-189). A missing file is skipped (no warning); the
## city uses the existing `highway_night_loop` until `amb_city_day_loop` exists.

## id -> [file, fallback ("" = none), gain dB]
const SOUNDS: Dictionary = {
	"cicadas": ["amb_cicadas_day_loop", "", -15.0],
	"sea": ["amb_sea_waves_loop", "", -13.0],
	"city_day": ["amb_city_day_loop", "highway_night_loop", -17.0],
	"city_night": ["amb_city_night_loop", "highway_night_loop", -15.0],
	"night_insects": ["amb_night_frogs_crickets_loop", "", -14.0],
	"birds": ["amb_birds_day_loop", "", -18.0],
}

var active: Array[String] = []       # ids chosen for this race (tests)
var _players: Array[AudioStreamPlayer] = []
var _gains: Array[float] = []
var _level: float = 0.0


## Which ambiences play for a scenery and time of day (pure: tests).
static func pick(scenery: StringName, tod: TimeOfDay) -> Array[String]:
	var day: bool = tod.day_amount >= 0.5
	var out: Array[String] = []
	match scenery:
		&"city":
			out.append("city_day" if day else "city_night")
		&"coast":
			out.append("sea")
			out.append("birds" if day else "night_insects")
		_:
			out.append("cicadas" if day else "night_insects")
			if day:
				out.append("birds")
	return out


## File that will play for `id` ("" = none available).
static func file_for(id: String) -> String:
	var s: Array = SOUNDS[id]
	if RaceAudio.has_sound(String(s[0])):
		return String(s[0])
	if String(s[1]) != "" and RaceAudio.has_sound(String(s[1])):
		return String(s[1])
	return ""


func setup(scenery: StringName, tod: TimeOfDay) -> void:
	name = "Ambience"
	active = pick(scenery, tod)
	var bus: Node = (Engine.get_main_loop() as SceneTree).root.get_node_or_null("AudioBus")
	for id in active:
		var f: String = file_for(id)
		if f == "" or bus == null:
			continue
		var p := AudioStreamPlayer.new()
		p.stream = bus.call("stream", f)
		p.bus = "SFX"
		p.volume_db = -80.0
		add_child(p)
		if p.stream != null:
			p.play()
			_players.append(p)
			_gains.append(float(SOUNDS[id][2]))


## `tunnel` = 0 outside .. 1 deep inside; `speed` m/s (the wind masks a bit of it).
func update(dt: float, tunnel: float, speed: float) -> void:
	var target: float = (1.0 - clampf(tunnel * 1.4, 0.0, 1.0)) * lerpf(1.0, 0.7, clampf(speed / 35.0, 0.0, 1.0))
	_level = move_toward(_level, target, dt * 0.8)
	for i in _players.size():
		_players[i].volume_db = _gains[i] + linear_to_db(maxf(_level, 0.0001)) if _level > 0.01 else -80.0
